// Схема данных личного Kanban-трекера.
// Документация: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(cuid())
  name      String   @default("My Board")
  createdAt DateTime @default(now())
  columns   Column[]
}

model Column {
  id      String @id @default(cuid())
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  name    String
  order   Int
  tasks   Task[]
}

model Task {
  id          String      @id @default(cuid())
  column      Column      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId    String
  title       String
  description String?
  dueDate     DateTime?
  priority    String?
  order       Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  comments    Comment[]
  reminders   Reminder[]
  taskLabels  TaskLabel[]
  subtasks    Subtask[]
}

model Comment {
  id         String   @id @default(cuid())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId     String
  authorName String
  body       String
  createdAt  DateTime @default(now())
}

model Reminder {
  id            String    @id @default(cuid())
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId        String
  offsetMinutes Int
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
}

model Label {
  id         String      @id @default(cuid())
  name       String      @unique
  color      String      @default("#6366f1")
  taskLabels TaskLabel[]
}

// Явная join-таблица вместо неявного many-to-many Prisma — так проще и надёжнее
// написать миграцию руками (см. комментарий в prisma/migrations/.../migration.sql).
model TaskLabel {
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId  String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  labelId String

  @@id([taskId, labelId])
}

model Subtask {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  title     String
  done      Boolean  @default(false)
  order     Int
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
