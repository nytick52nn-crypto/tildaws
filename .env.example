# Строка подключения к Postgres (Vercel Postgres / Neon).
# Локально: скопируй значение из Vercel → Storage → твоя база → .env.local tab
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Container ID из Google Tag Manager, например GTM-XXXXXXX
# Если не задан — GTM-скрипт просто не рендерится, локальная разработка работает и без него.
NEXT_PUBLIC_GTM_ID=
