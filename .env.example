# Строка подключения к Postgres (Vercel Postgres / Neon).
# Локально: скопируй значение из Vercel → Storage → твоя база → .env.local tab
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Container ID из Google Tag Manager, например GTM-XXXXXXX
# Если не задан — GTM-скрипт просто не рендерится, локальная разработка работает и без него.
NEXT_PUBLIC_GTM_ID=

# Ключи Web Push (генерируются один раз: npx web-push generate-vapid-keys --json)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Секрет для внешнего cron-job.org, который дёргает /api/cron/send-reminders —
# любая случайная строка, никогда не попадает в браузер
CRON_SECRET=

# Токен для браузерных push-роутов (/api/push/*) — попадает в клиентский бандл,
# это не настоящая защита, а барьер от случайного сканирования извне
NEXT_PUBLIC_PUSH_TOKEN=

# Публичный URL сайта, нужен для абсолютных ссылок в пуш-уведомлениях
NEXT_PUBLIC_SITE_URL=https://tildaws.vercel.app

# Секрет для .ics-фида (/api/ics/<токен>) — часть самого URL, не заголовок,
# т.к. календарные приложения не умеют слать кастомные заголовки при подписке.
# Никогда не должен попасть в клиентский бандл.
ICS_FEED_TOKEN=
